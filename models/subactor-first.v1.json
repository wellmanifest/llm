{
  "$schema": "./llm-profile.schema.json",
  "schema": "wellmanifest.llm-profile/v1",
  "profileId": "subactor-first",
  "version": "1.0.0",
  "placement": {
    "home": "wellmanifest",
    "shape": "domain_pack",
    "runtimeOwner": "subactor",
    "adopt": [
      "wellmanifest/new-project",
      "wellmanifest/dsl",
      "wellmanifest/logs"
    ]
  },
  "bootstrap": {
    "marker": "SUBACTOR-FIRST",
    "profileTarget": ".wellmanifest/llm.json",
    "schemaTargets": {
      "profile": ".wellmanifest/llm-profile.schema.json",
      "request": ".wellmanifest/request.schema.json",
      "response": ".wellmanifest/response.schema.json"
    },
    "adapterTargets": {
      "codex": "AGENTS.md",
      "claude": "CLAUDE.md",
      "gemini": "GEMINI.md",
      "cursor": ".cursor/rules/subactor-first.mdc",
      "copilot": ".github/copilot-instructions.md",
      "generic": "SUBACTOR.md"
    }
  },
  "transport": {
    "preferred": "mcp",
    "fallbacks": ["https", "cli", "file"],
    "semanticEnvelope": "application/json"
  },
  "workflow": [
    {"id": "discover", "operation": "profile.resolve", "required": true},
    {"id": "knowledge", "operation": "knowledge.resolve", "required": true},
    {"id": "artifact", "operation": "artifact.resolve", "required": true, "when": "textual artifact, JSON, schema or DSL is in scope"},
    {"id": "observe", "operation": "observation.read", "required": false, "when": "current operational state is needed"},
    {"id": "research", "operation": "research.plan", "required": true, "when": "knowledge is missing, stale or explicitly needs re-verification"},
    {"id": "invoke", "operation": "llm.invoke", "required": true},
    {"id": "validate", "operation": "validation.run", "required": true},
    {"id": "receipt", "operation": "receipt.write", "required": true}
  ],
  "authority": {
    "llm": "advisory",
    "mutation": "external-grant",
    "merge": "trusted-validator"
  },
  "security": {
    "credentials": "out-of-context",
    "secretReferences": "opaque",
    "secretsInContext": false,
    "secretsInUris": false,
    "secretsInLogs": false
  },
  "limits": {
    "maxKnowledgeItems": 12,
    "maxContextBytes": 131072,
    "maxObservationSeconds": 60,
    "maxExternalQueries": 4
  },
  "receipt": {
    "redacted": true,
    "immutableRefs": true,
    "recordRoute": true,
    "recordModel": true
  }
}
